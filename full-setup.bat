@echo off
chcp 65001 >nul
title ?? Food Delivery - Повне налаштування

echo.
echo ?????????????????????????????????????????????????????????
echo ?               ?? FOOD DELIVERY SETUP                 ?
echo ?                 Повне налаштування                   ?
echo ?????????????????????????????????????????????????????????
echo.

REM Перевірка Node.js
echo [1/5] ?? Перевірка Node.js...
node --version >nul 2>&1
if errorlevel 1 (
    echo ? Node.js не знайдено!
    echo ?? Завантажте та встановіть Node.js з https://nodejs.org/
    pause
    exit /b 1
)
echo ? Node.js знайдено

REM Перевірка MySQL
echo [2/5] ?? Перевірка MySQL...
mysql --version >nul 2>&1
if errorlevel 1 (
    echo ? MySQL не знайдено!
    echo ?? Встановіть XAMPP, WAMP або MySQL окремо
    echo ?? XAMPP: https://www.apachefriends.org/
    pause
    exit /b 1
)
echo ? MySQL знайдено

REM Встановлення залежностей
echo [3/5] ?? Встановлення залежностей...
npm install
if errorlevel 1 (
    echo ? Помилка встановлення залежностей
    pause
    exit /b 1
)
echo ? Залежності встановлені

REM Налаштування бази даних
echo [4/5] ??? Налаштування бази даних...
echo Введіть пароль для MySQL користувача root:
mysql -u root -p < database/quick_setup.sql
if errorlevel 1 (
    echo ? Помилка створення бази даних
    echo ?? Переконайтеся що MySQL запущений і пароль правильний
    pause
    exit /b 1
)
echo ? База даних створена

REM Додавання тестових даних
echo [5/5] ?? Додавання тестових даних...
echo Введіть пароль ще раз для додавання тестових даних:
mysql -u root -p food_delivery < database/test_data.sql
if errorlevel 1 (
    echo ? Помилка додавання тестових даних
    pause
    exit /b 1
)
echo ? Тестові дані додані

