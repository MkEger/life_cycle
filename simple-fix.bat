@echo off
chcp 65001 >nul
title ?? SIMPLE FIX - Food Delivery

echo.
echo ????????????????????????????????????????????????????????????
echo ?                ?? SIMPLE FIX                            ?
echo ?           Food Delivery Quick Test                       ?
echo ????????????????????????????????????????????????????????????
echo.

echo [1/4] ?? Kill any running processes...
taskkill /f /im node.exe >nul 2>&1
timeout /t 2 >nul

echo [2/4] ?? Start fresh server...
echo Starting Node.js server...
start /min cmd /c "node server.js"
timeout /t 4 >nul

echo [3/4] ?? Test basic connectivity...
curl -s http://localhost:3000/api/test >nul 2>&1
if %errorlevel%==0 (
    echo ? Server is responding
) else (
    echo ? Server not responding
    echo Please wait and try again...
    timeout /t 3 >nul
)

echo [4/4] ?? Quick API test...
curl -s http://localhost:3000/api/orders/user | findstr "restaurant_name" >nul 2>&1
if %errorlevel%==0 (
    echo ? Orders API is working
) else (
    echo ?? Orders API might need more time
)

echo.
echo ????????????????????????????????????????????????????????????
echo ?                ? READY FOR TESTING                     ?
echo ????????????????????????????????????????????????????????????
echo.

echo ?? TEST OPTIONS:
echo.
echo 1?? BASIC TEST PAGE:
echo    URL: http://localhost:3000/test.html
echo    ? This will test all APIs and show detailed results
echo.
echo 2?? PROFILE PAGE TEST:
echo    URL: http://localhost:3000/pages/profile.html
echo    Login: test@example.com / test123
echo    ? Check "My Orders" tab
echo.
echo 3?? DIRECT API TEST:
echo    URL: http://localhost:3000/api/orders/user
echo    ? Should show JSON with restaurant names
echo.

set /p choice="Which test? (1=Basic, 2=Profile, 3=API, Enter=All): "

if "%choice%"=="1" (
    echo ?? Opening basic test page...
    start http://localhost:3000/test.html
) else if "%choice%"=="2" (
    echo ?? Opening profile page...
    start http://localhost:3000/pages/profile.html
) else if "%choice%"=="3" (
    echo ?? Opening API endpoint...
    start http://localhost:3000/api/orders/user
) else (
    echo ?? Opening all test options...
    start http://localhost:3000/test.html
    timeout /t 2 >nul
    start http://localhost:3000/pages/profile.html
)

echo.
echo ?? TROUBLESHOOTING:
echo • If you see diamond symbols (???) instead of text:
echo   ? Try Ctrl+F5 to hard refresh
echo   ? Try a different browser
echo   ? Check the test.html page first
echo.
echo • If pages don't load:
echo   ? Check if server is running in background
echo   ? Try: node server.js manually
echo.
echo ?? Server logs are in the background window

pause